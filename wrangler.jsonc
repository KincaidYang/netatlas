{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netatlas",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "not_found_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "CATALOG", "class_name": "CatalogCache" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "BUDGET", "class_name": "DailyBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CatalogCache", "RateLimiter", "DailyBudget"] }
  ],
  // Bootstraps the catalogue. CatalogCache reschedules its own sweeps with a
  // Durable Object alarm, but nothing arms the first one until something talks
  // to the object — so a deploy followed by no traffic would leave it asleep
  // and the next visitor would still be served a stale catalogue. This poke
  // costs one Durable Object fetch an hour and usually does nothing: the object
  // only sweeps when its snapshot is past the TTL.
  "triggers": { "crons": ["0 * * * *"] }
  // Secrets (set with `wrangler secret put <NAME>`, do NOT put them here):
  //   ATLAS_API_KEY  — RIPE Atlas API key with credits (required)
  //   ADMIN_TOKEN    — optional; guards /admin/* (budget inspection, catalogue refresh)
  // Plain vars you may set here or in the dashboard:
  //   PUBLIC_DAILY_CREDITS   — global anonymous budget per UTC day (default 120000)
  //   ALLOW_ANY_HTTP_TARGET  — "1" only if RIPE whitelisted this account for non-anchor HTTP
}
